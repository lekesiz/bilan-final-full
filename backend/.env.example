# ============================================
# BILAN Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env or .env.local to version control
# ============================================

# ============================================
# REQUIRED - Database Configuration
# ============================================
# For Docker Compose (production):
DATABASE_URL=postgresql://bilan_user:bilan_password@postgres:5432/bilan_easy

# For local development (outside Docker):
# DATABASE_URL=postgresql://your_username:your_password@localhost:5432/bilan_easy

# ============================================
# REQUIRED - Security Configuration
# ============================================
# JWT Secret - MUST be set to a secure random value in production
# Generate with: openssl rand -base64 32
# NEVER use the default value in production!
JWT_SECRET=your-secret-key-change-in-production

# JWT Token Expiration (optional, default: 7d)
# Examples: 1h, 24h, 7d, 30d
JWT_EXPIRES_IN=7d

# ============================================
# REQUIRED - Server Configuration
# ============================================
# Server port (optional, default: 3001)
PORT=3001

# Node environment: development, production, test
NODE_ENV=development

# ============================================
# REQUIRED - Frontend Configuration
# ============================================
# Frontend URL for CORS (optional, default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# ============================================
# OPTIONAL - AI Service Configuration
# ============================================
# At least one AI provider API key is recommended for full functionality
# OpenAI API Key (for GPT models)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for Claude models)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Gemini API Key (for Gemini models)
# GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# Gemini Max Concurrency (optional, default: 2)
# GEMINI_MAX_CONCURRENCY=2

# ============================================
# OPTIONAL - Test Mode Configuration
# ============================================
# TEST_MODE: Only enable in test environment
# WARNING: Enabling this in production will bypass authentication!
# Set to 'true' only for testing, NEVER in production
TEST_MODE=false

# ============================================
# OPTIONAL - Admin User (for seed script)
# ============================================
# Default admin user created by seed script
# ADMIN_EMAIL=admin@bilan.com
# ADMIN_PASSWORD=admin123
# ADMIN_NAME=Admin User

# ============================================
# OPTIONAL - Monitoring & Error Tracking
# ============================================
# Sentry DSN for error tracking (optional)
# Uncomment and set to enable Sentry error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry environment (optional)
# SENTRY_ENVIRONMENT=production

# App version for Sentry releases (optional)
# APP_VERSION=1.0.0

# ============================================
# OPTIONAL - Logging
# ============================================
# Log level: error, warn, info, debug (optional, default: info)
# LOG_LEVEL=info

# ============================================
# SECURITY NOTES
# ============================================
# 1. JWT_SECRET: MUST be a secure random value in production
#    Generate: openssl rand -base64 32
#
# 2. TEST_MODE: MUST be false in production
#    Enabling TEST_MODE bypasses all authentication!
#
# 3. API Keys: Store securely, never commit to version control
#
# 4. Database: Use strong passwords, restrict network access
#
# 5. Production Checklist:
#    - Set NODE_ENV=production
#    - Set JWT_SECRET to secure random value
#    - Set TEST_MODE=false (or remove it)
#    - Use HTTPS (FRONTEND_URL should be https://)
#    - Configure proper CORS origins
#    - Enable rate limiting (configured in code)
#    - Set up security headers (configured in code)
#    - Configure database backups
#    - Set up monitoring (Sentry, etc.)
