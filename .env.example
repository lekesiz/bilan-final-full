# ============================================
# BILAN Frontend Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# ============================================

# ============================================
# REQUIRED - Backend API Configuration
# ============================================
# Backend API URL
# For local development: http://localhost:3001/api
# For production: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:3001/api

# ============================================
# RECOMMENDED - Backend AI Proxy
# ============================================
# When true, AI requests go through backend API (more secure)
# When false, AI requests use frontend providers (fallback)
# RECOMMENDED: Set to true for production
VITE_USE_BACKEND_AI=true

# ============================================
# OPTIONAL - Frontend AI Provider Keys
# ============================================
# Note: These are only used if VITE_USE_BACKEND_AI=false
# In production, use backend AI proxy instead (more secure)
# These are fallback keys for development/testing

# Google Gemini API Key
# VITE_GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# OpenAI API Key
# VITE_OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude API Key
# VITE_CLAUDE_API_KEY=sk-ant-your-anthropic-api-key-here

# ============================================
# OPTIONAL - AI Model Configuration
# ============================================
# OpenAI Model (optional, default: gpt-4o)
# VITE_OPENAI_MODEL=gpt-4o

# Claude Model (optional, default: claude-3-5-sonnet-20241022)
# VITE_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Gemini Max Concurrency (optional, default: 2)
# VITE_GEMINI_MAX_CONCURRENCY=2

# Gemini Fallback Model (optional)
# VITE_GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# ============================================
# OPTIONAL - Monitoring & Error Tracking
# ============================================
# Sentry DSN for error tracking (optional)
# Uncomment and set to enable Sentry error tracking
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Enable Sentry in development (optional, default: false)
# VITE_ENABLE_SENTRY=false

# ============================================
# SECURITY NOTES
# ============================================
# 1. API Keys: Store securely, never commit to version control
#    - Use .env.local (git-ignored) for local development
#    - Use environment variables for production deployment
#
# 2. Backend AI Proxy: RECOMMENDED for production
#    - More secure (keys stay on backend)
#    - Better rate limiting
#    - Centralized logging
#
# 3. Frontend AI Keys: Only for development/fallback
#    - Never expose production keys in frontend
#    - Use backend proxy in production
